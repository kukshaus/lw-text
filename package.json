{
  "name": "lw-text",
  "version": "0.1.0",
  "private": true,
  "description": "AI-first enterprise document composition platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @lw-text/server",
    "dev:studio": "npm run dev --workspace @lw-text/studio",
    "start": "node packages/server/dist/index.js",
    "lw": "node packages/cli/dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.1"
  }
}
